{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psyche-timeline.local/schemas/extraction-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "summary", "confidence", "evidence", "operations", "violations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "summary": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence" } },
    "operations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/domainOperation" } },
    "violations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/violation" } }
  }
}
